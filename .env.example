# ---- LLM ----
MOCK_LLM=false                     # true = run the whole pipeline without a model
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434  # docker compose overrides this to host.docker.internal
LLM_TIMEOUT=120
LLM_THINK=false                    # reasoning models only (qwen3...): true is several times slower
LLM_KEEP_ALIVE=30m                 # how long Ollama keeps the model loaded between questions
# ---- Login ----
AUTH_REQUIRED=true                 # false = no login, identity from the X-Student-Id header (test harness only)
JWT_SECRET=                        # empty = a random key is generated into storage/jwt_secret
JWT_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin               # admin account created on first start; only admins add documents
ADMIN_PASSWORD=Admin@123
INITIAL_PASSWORD=Pass@{student_id} # first password of every student; stored as plain text
# Cloud fallback (disabled by default; disclosed in README). OpenAI-compatible endpoint.
CLOUD_FALLBACK=false
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
# ---- Retrieval (compared in eval) ----
EMBEDDING_MODEL=minilm             # minilm | bge
CHUNK_STRATEGY=section             # section | fixed
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
# ---- OCR (scanned PDFs and images) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if tesseract is not on PATH; this Windows default is found automatically
# ---- Data ----
REGISTER_CSV=docs/sample/source_register.csv   # switch to docs/source_register.csv once your real documents are in
